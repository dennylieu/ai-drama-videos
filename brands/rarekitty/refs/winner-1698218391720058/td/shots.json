  "start": 176.43,
  "end": 181.47,
  "dur": 5.03,
  "frames": [
   "frames/s50_a.jpg",
   "frames/s50_m.jpg",
   "frames/s50_z.jpg"
  ],
  "words": "Week one, the deep lines across my forehead started to go quiet."
 },
 {
